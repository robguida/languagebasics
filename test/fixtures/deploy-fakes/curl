#!/usr/bin/env bash
# Fake web server (tests only) over $FAKE_ROOT/current, for lb-release.sh smoke and deploy.sh's outside checks.
# FAKE_SMOKE_FAIL=1 serves a broken index.html for every release.
# FAKE_SMOKE_FAIL_ID="<id> [<id>...]" serves a broken index.html only while one of those releases is current.
#   An entry may also be the 12-character commit part of a release id (a test cannot know the time part).
# FAKE_HEADERS=<file> also sends the headers from a file in the expected-headers.txt format:
#   "Name: value" on every 200 answer, ".ext Name: value" only for that type (.html covers the app's
#   address), "!Name" and comment lines are skipped. Its Content-Type lines replace the fake's own.
# FAKE_CORRUPT="<path> ..." serves changed bytes for those app paths (e.g. engine.js), as a stale or
#   tampered CDN copy would.
# FAKE_SERVE="<path> ..." answers 200 for those app paths although no release file is there (e.g.
#   package.json), as a server that leaks a private file would.
# Speed: a deploy test calls this fake hundreds of times, and every extra process costs a lot on
# Windows. So it uses bash built-ins only (no mktemp, cp, rm or cat): a release file is read into
# memory with read -d '' and written back unchanged. Release files in the tests are text (no NUL
# byte); a NUL would change the bytes, and the hash checks would then fail loudly, never pass.
# FAKE_ARGS=<file>: every call also adds one line with its FULL argument list ("curl", then each
# argument, tab-separated; inside an argument a backslash is doubled, and a tab or new line is
# written as backslash-t or backslash-n).
# Allow list: only the options the kit and the server script use are accepted (-q -s -S -sS -g,
# and --proto --max-time -o -D -w -H with a value) plus exactly one address. Anything else (an
# unknown or misspelt option, a second address) is refused with exit 2, as real curl would refuse
# or misread it, so a test cannot pass on a call the real curl would not run.
if [ -n "${FAKE_ARGS:-}" ]; then
  line=curl bs='\'
  for a in "$@"; do a=${a//"$bs"/"$bs$bs"}; a=${a//$'\t'/"${bs}t"}; a=${a//$'\n'/"${bs}n"}; line+=$'\t'"$a"; done
  printf '%s\n' "$line" >> "$FAKE_ARGS"
fi
out=- hdr="" fmt="" url="" nurl=0
while [ $# -gt 0 ]; do
  case "$1" in
    -o|-D|-w|-H|--max-time|--proto)
      [ $# -ge 2 ] || { echo "fake curl: option $1 needs a value" >&2; exit 2; }
      case "$1" in -o) out=$2 ;; -D) hdr=$2 ;; -w) fmt=$2 ;; esac
      shift ;;
    -q|-s|-S|-sS|-g) ;;
    -*) echo "fake curl: option $1 is not on the allow list" >&2; exit 2 ;;
    *) url=$1; nurl=$((nurl+1)) ;;
  esac
  shift
done
[ "$nurl" = 1 ] || { echo "fake curl: expected exactly one address, got $nurl" >&2; exit 2; }
echo "curl $url" >> "$FAKE_CALLS"
p=${url#*://}; p=/${p#*/}; q=""
case "$p" in *\?*) q="?${p#*\?}"; p=${p%%\?*} ;; esac
code=404 ct="text/html" redir="" body="" ext=.html
if [ "$p" = /languagebasics ]; then code=301; redir="/languagebasics/$q"
elif [[ "$p" == /languagebasics/* ]]; then
  rel=${p#/languagebasics/}; raw=$rel
  if [ -z "$rel" ] || [[ "$rel" == */ ]]; then rel="${rel}index.html"; fi
  f="$FAKE_ROOT/current/$rel"
  if [[ "/$rel" != */.* ]] && [ -f "$f" ]; then code=200; IFS= read -r -d '' body < "$f"; fi
  for x in ${FAKE_SERVE:-}; do [ "$x" = "$raw" ] && { code=200; body=$'leaked\n'; }; done
  if [ "$code" = 200 ]; then for x in ${FAKE_CORRUPT:-}; do [ "$x" = "$rel" ] && body+=$'// changed\n'; done; fi
  case "$rel" in *.js) ct="application/javascript; charset=utf-8"; ext=.js ;; *.css) ct="text/css"; ext=.css ;; *) ct="text/html; charset=utf-8" ;; esac
  if [ "$code" = 200 ] && [ "$rel" = index.html ]; then
    broken=${FAKE_SMOKE_FAIL:-}
    if [ -z "$broken" ] && [ -n "${FAKE_SMOKE_FAIL_ID:-}" ]; then
      cur=$(readlink "$FAKE_ROOT/current" 2>/dev/null); cur=${cur%/}; cur=${cur##*/}
      for x in $FAKE_SMOKE_FAIL_ID; do { [ "$x" = "$cur" ] || [ "$x" = "${cur##*-}" ]; } && broken=1; done
    fi
    [ -n "$broken" ] && body=$'broken\n'
  fi
fi
H="HTTP/1.1 $code X"
extra=""
if [ "$code" = 200 ] && [ -n "${FAKE_HEADERS:-}" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ "$line" == '!'* ]] && continue
    if [[ "$line" == .* ]]; then [[ "$line" == "$ext "* ]] || continue; line=${line#* }; fi
    case "${line%%:*}" in [Cc]ontent-[Tt]ype) ct=${line#*:}; ct=${ct# }; continue ;; esac
    extra="$extra
$line"
  done < "$FAKE_HEADERS"
fi
H="$H
Content-Type: $ct$extra"
[ -n "$redir" ] && H="$H
Location: $redir"
H=${H//$'\n'/$'\r\n'}
if [ "$hdr" = - ]; then printf '%s\r\n\r\n' "$H"; elif [ -n "$hdr" ]; then printf '%s\r\n\r\n' "$H" > "$hdr"; fi
if [ "$out" = - ]; then printf '%s' "$body"; elif [ "$out" != /dev/null ]; then printf '%s' "$body" > "$out"; fi
w=${fmt//'%{http_code}'/$code}; w=${w//'%{content_type}'/$ct}; w=${w//'%{redirect_url}'/$redir}
printf '%s' "$w"
