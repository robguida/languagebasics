# deploy.env.example - the shape of the private deploy settings. Placeholders only.
#
# Copy this file OUTSIDE the repo, then fill in the real values there:
#   default place:  $HOME/.config/languagebasics/deploy.env
#   or any place:   LB_DEPLOY_CONFIG=<path to your file>
# deploy.sh refuses if the file is inside this repo, inside any git working tree, tracked by git,
# has an empty value, has an unknown setting, or still holds a <placeholder>.
# Never commit the real file. Format: KEY=value, one per line; no shell code is run from it.

# The server
LB_HOST=<server public address>
LB_HOST_FPR=<server ED25519 host key fingerprint, SHA256:...>
LB_SSH_USER=<server login name>
LB_SSH_KEY=<path to the private SSH key on this computer>

# Folders on the server (absolute paths)
LB_BOX_KIT=<folder on the server that holds the release script and incoming uploads>
LB_BOX_ROOT=<folder on the server that holds releases/, current and deploys.log>
LB_BOX_ROUTE_FILE=<the web server's route file for the app; smoke fails if it is missing>

# Folder on this computer for the clone, builds, logs and known_hosts. Must be outside any repo.
LB_WORK_DIR=<folder on this computer, outside any repo>

# Optional
# LB_SITE_URL=<public https address of the app, ending in />   (default: the live app address)
# LB_EXPECT_TREE=<40-character tree id the approved commit must have>
# LB_KEEP=<good releases kept on the server, 2 or more>          (default 5)
